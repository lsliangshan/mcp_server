{
  "name": "owlscript-server",
  "version": "1.0.0",
  "description": "OwlScript Server",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "dev:zhaopin": "tsc -w & chmod 755 build/servers/zhaopin.js & npx tsx build/servers/zhaopin.js",
    "dev:test": "tsc -w & chmod 755 build/servers/test.js & npx tsx build/servers/test.js",
    "dev": "npm run dev:zhaopin & npm run dev:test",
    "start:zhaopin": "npx tsx build/servers/zhaopin.js",
    "start:test": "npx tsx build/servers/test.js",
    "pm2:zhaopin": "pm2 startOrGracefulReload pm2-zhaopin.json",
    "pm2:test": "pm2 startOrGracefulReload pm2-test.json"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "axios": "^1.8.4",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.4.7",
    "fastmcp": "^1.20.5",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}